FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies and MS Core Fonts BEFORE python3.11
# (package-data-downloader requires system python3.10's apt_pkg module)
RUN apt-get update && \
    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
    apt-get install -y \
        libfontconfig1 \
        fontconfig \
        libegl1-mesa \
        libgl1-mesa-glx \
        libglib2.0-0 \
        fonts-noto-color-emoji \
        wget \
        cabextract \
        ttf-mscorefonts-installer && \
    rm -rf /var/lib/apt/lists/*

# ttf-mscorefonts-installer downloads fonts from SourceForge, which is
# unreliable (mirrors go down, timeouts). Retry the download up to 3 times
# and verify that Arial (a core font) is actually installed.
RUN for attempt in 1 2 3; do \
        echo "MS fonts download attempt $attempt..." && \
        /usr/lib/msttcorefonts/update-ms-fonts && \
        fc-cache -f && \
        fc-match Arial | grep -qi arial && break; \
        echo "Attempt $attempt failed, retrying in 5s..." && sleep 5; \
    done && \
    fc-match Arial | grep -qi arial || (echo "ERROR: MS Core Fonts failed to install" && exit 1)

# Install Python 3.11 and set as default
RUN apt-get update && \
    apt-get install -y python3.11 python3-pip && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN python -m pip install --upgrade pip && \
    pip install -e ".[test]"

CMD ["bash"]